{
  "version": "1.0",
  "created": "2026-09-03",
  "description": "一念永恒项目角色卡间数据交换契约",
  "分析卡输出": {
    "四层分析": {
      "表象层": {
        "字段": "surface",
        "格式": "string",
        "说明": "原文直接可观察的内容"
      },
      "结构层": {
        "字段": "structure",
        "格式": "string",
        "说明": "叙事结构/起承转合/段落功能"
      },
      "情感层": {
        "字段": "emotion",
        "格式": "string",
        "说明": "人物情感变化/情绪基调"
      },
      "思想层": {
        "字段": "thought",
        "格式": "string",
        "说明": "主题/价值观/哲学思考"
      }
    },
    "元数据": {
      "task_id": {
        "格式": "string",
        "说明": "任务唯一标识"
      },
      "source_file": {
        "格式": "string",
        "说明": "源文件路径"
      },
      "chapter": {
        "格式": "int",
        "说明": "章节号"
      },
      "timestamp": {
        "格式": "string",
        "说明": "分析时间"
      },
      "analyzer_version": {
        "格式": "string",
        "说明": "分析卡版本号"
      }
    }
  },
  "匹配卡输入": {
    "依赖": "分析卡输出的四层分析JSON",
    "匹配逻辑": "思想层→情感层→结构层→表象层(漏斗筛选)",
    "输出格式": "匹配结果JSON"
  },
  "学生卡适用场景": {
    "创作模式": "自下而上(感觉→情感→思想)——用于生成/创作",
    "拆解模式": "自上而下(表象→结构→情感→思想)——用于分析/拆解",
    "规则": "学生卡负责创作,分析卡负责拆解,适用场景不同"
  },
  "通用规则": [
    "所有角色卡输出必须包含元数据头部",
    "分析卡输出必须严格遵循四层格式",
    "匹配卡必须基于分析卡输出",
    "版本变更时必须更新此Schema"
  ]
}